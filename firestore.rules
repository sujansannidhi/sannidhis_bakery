rules_version = '2';

// Deny everything.
//
// This is not an oversight — it is the security model. Every read and write in
// this app goes through the Firebase Admin SDK on the server, and the Admin SDK
// bypasses these rules by design. So there is no legitimate client-side access
// to deny, and closing the door completely means a browser cannot reach this
// data even if someone obtains the project's public config.
//
// If you ever add a client-side Firebase SDK, this file must be revisited
// deliberately rather than loosened in a hurry.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
