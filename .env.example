# Copy to .env.local for local development. .env.local is gitignored.
# In production these live in Vercel: Settings -> Environment Variables.
# Never commit real values.

# --- Admin access -----------------------------------------------------------
# Generate both with: openssl rand -base64 32
# ADMIN_PASSWORD is what you type to sign in. Store it in a password manager.
ADMIN_PASSWORD=
# Signs the session cookie. Changing this signs everyone out immediately, which
# is the lever to pull if the password ever leaks.
ADMIN_SESSION_SECRET=

# --- Firebase (stores order enquiries) --------------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. The downloaded JSON contains all three of these.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value exactly as it appears in the JSON, including the
# \n sequences and the surrounding quotes.
FIREBASE_PRIVATE_KEY=

# --- GitHub (publishes content changes) -------------------------------------
# A fine-grained personal access token scoped to THIS REPOSITORY ONLY, with
# Contents: read and write. Nothing else.
GITHUB_TOKEN=
GITHUB_REPO=sujansannidhi/sannidhis_bakery
GITHUB_BRANCH=main

# --- Firebase Storage (holds photographs uploaded through the admin) --------
# Only needed if your bucket is not the project default. Enable Storage first:
# Firebase console -> Build -> Storage -> Get started.
FIREBASE_STORAGE_BUCKET=

# --- Email (confirmations to customers, quotes from the admin) --------------
# Gmail with an app password. Requires 2-factor on the Google account:
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords.
# Paste the password without the spaces Google displays it with.
GMAIL_USER=
GMAIL_APP_PASSWORD=
